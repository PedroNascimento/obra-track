# =============================================================
# ObraTrack — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env.local e preencha os valores reais

# ------------------------------------------------------------
# BANCO DE DADOS — Supabase PostgreSQL
# Supabase → Settings → Database → Connection String (URI)
# Use a "Transaction Pooler" URL para DATABASE_URL (porta 6543)
# Use a "Direct Connection" URL para DIRECT_URL (porta 5432)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# AUTH — JWT Secret
# Gere um segredo forte: openssl rand -base64 32
# ------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------
# NEXT.JS
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
